# ==========================================
# Sales AI Intelligence Engine - Environment Template
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=sales_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_ai

# Redis & Celery Distributed Task Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_SCHEDULE_DAYS=15

# API Keys & Scraper Tokens
APIFY_TOKEN=your_apify_api_token_here
MONID_API_KEY=your_monid_api_key_here
MONID_BASE_URL=https://api.monid.ai/v1

# AI Search & Neural Intelligence APIs
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SERPER_API_KEY=your_serper_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Pipeline Configuration
DEFAULT_HIERARCHY_LIMIT=50
OUTPUT_DIR=output

# ── Microsoft 365 activity capture (apps/sales_crm/capture) ──
# Entra ID app registration (single tenant). Redirect URI: {APP_BASE_URL}/api/crm/capture/callback/microsoft
# Delegated Graph permissions: offline_access, User.Read, Mail.Read, Calendars.Read (grant admin consent)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# MS_REDIRECT_URI=            # optional override
# Fernet key for encrypting stored Microsoft tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAPTURE_TOKEN_KEY=

# ==========================================================================
# Content pipeline (apps/content_pipeline) — reads this same file via envfile.py.
# CONTENT_APIFY_TOKEN: the scrapers' Apify account (leave blank to reuse APIFY_TOKEN).
# The pipeline uses DATABASE_URL above unless DB_USE_LOCAL=false (then DATABASE_URL_NEON).
# ==========================================================================
CONTENT_APIFY_TOKEN=
DEFAULT_POST_LIMIT=
LINKEDIN_TIMEOUT=
REDDIT_TIMEOUT=
TWITTER_TIMEOUT=
BLOG_TIMEOUT=
LINKEDIN_ACTOR_ID=
REDDIT_ACTOR_ID=
TWITTER_ACTOR_ID=
BLOG_ACTOR_ID=
SAVE_OUTPUT=
PRETTY_PRINT=
LOG_LEVEL=
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SEC_USER_AGENT=
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
DATABASE_URL_NEON=
DB_USE_LOCAL=true
API_KEY=
YOUTUBE_API_KEY=
CALLPREP_LLM_MODEL=
