# Environment & Secrets
.env
*.env.local
dump_to_neon.py
db/dump_to_neon.py

# Output & Scraped Data
output/
*.json
# ...except tracked tooling config that happens to be JSON (the *.json
# rule above is aimed at scraped/output data, not config files).
!package.json
!package-lock.json
!.eslintrc.json
!.stylelintrc.json

# Node (frontend lint tooling — eslint/htmlhint/stylelint, no build step)
node_modules/

# Python & Virtual Environments
venv/
env/
ENV/
# The dev venv at this repo's root (pyvenv.cfg, Lib/, Scripts/) already
# ignores itself via its own generated sales_agent-ai/.gitignore — this
# is a belt-and-suspenders rule in case that file is ever missing (e.g.
# venv recreated without it, or created with a tool that skips it).
sales_agent-ai/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Celery & Redis Task Queue (Deferred for later update)
celery_app.py
tasks/
celerybeat-schedule
celerybeat.pid

# Logs & Temporary Files
scratch/
architecture_flow.md
*.log
.obsidian/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Temporary scratch test scripts & exports
scripts/test_*.py
scripts/inspect_*.py
scripts/audit_*.py
scripts/*_pdf.py
*.pdf

# Merge conflict backup files
.merge_backup/

.venv/

# Filled-in production settings (real keys) — never committed. Template: deploy/.env.production.example
deploy/.env.production

# Agent skills and workflow configurations
.agents/
skills/
*SKILL.md
*skill.md

