# ══════════════════════════════════════════════════════════════════════════════
# Doshin (Sales AI Agent) — production environment
#
# Copy to the GitHub environment "production" as the secret ENV_FILE (whole file),
# or to /opt/salesai/.env on the server. Fill every <…>. Never commit real values.
# Names here are exactly what the code reads (checked 2026-10-16, DEPLOYMENT_REVIEW.md W4).
# Docker env files take each line literally: no quotes, no comments after a value.
# ══════════════════════════════════════════════════════════════════════════════

# ── Public URLs ───────────────────────────────────────────────────────────────
# The public origin. Used for canonical/Open Graph links, the sitemap, email links and the
# Microsoft 365 redirect (MS_REDIRECT_URI defaults to {APP_BASE_URL}/api/crm/capture/callback/microsoft).
SITE_URL=https://<your-domain>
APP_BASE_URL=https://<your-domain>
# Same-origin app: list only the public origin.
CORS_ALLOWED_ORIGINS=https://<your-domain>

# ── Database (RDS PostgreSQL 18, private) ─────────────────────────────────────
DATABASE_URL=postgresql://saadmin:<password>@<rds-endpoint>:5432/sales_ai?sslmode=require

# Schema migrations (docs/DB_DEPLOYMENT_PLAN.md): remote_deploy.sh snapshots this RDS instance
# before applying pending migrations, and refuses to migrate without a snapshot unless
# SKIP_PRE_MIGRATION_SNAPSHOT=1. The EC2 instance role needs rds:CreateDBSnapshot,
# rds:DescribeDBSnapshots and rds:AddTagsToResource (deploy/AWS_SETUP.md, Step 4).
RDS_INSTANCE_ID=salesai-db
SKIP_PRE_MIGRATION_SNAPSHOT=0

# ── Security — REQUIRED ───────────────────────────────────────────────────────
# Off = every request runs as a super admin. Must be true in production.
AUTH_ENFORCED=true
# Login cookies only over HTTPS.
COOKIE_SECURE=true
# New random value for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<new-random-64>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_RESET_TOKEN_EXPIRE_MINUTES=30
# New-user invitation (set-password) link
JWT_INVITE_TOKEN_EXPIRE_HOURS=72
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Encrypts API keys saved on the Admin page. When copying the current database, this MUST be
# the key those rows were encrypted with — today that is your CURRENT JWT_SECRET_KEY (the dev
# .env has no CONFIG_ENCRYPTION_KEY). Set it once and never change it.
CONFIG_ENCRYPTION_KEY=<current-dev-JWT_SECRET_KEY>
# Fernet key for Microsoft 365 tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAPTURE_TOKEN_KEY=<fernet-key>

# First super admin — ONLY for an empty database. Leave unset when copying the current DB
# (it already has admins). If used: 12+ chars, then delete both lines after first start.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# ── Features ──────────────────────────────────────────────────────────────────
FORECAST_ENABLED=0
DEFAULT_HIERARCHY_LIMIT=<same-as-dev>

# ── Sales Copilot (RAG) ───────────────────────────────────────────────────────
# Must match the model baked into the image (Dockerfile EMBED_MODEL)
COPILOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
COPILOT_EMBED_DIMS=384
# Empty = embedded Chroma store in /app/output/chroma (one process owns it — keep 1 worker)
COPILOT_CHROMA_URL=
COPILOT_AUTOSYNC=1
COPILOT_SYNC_INTERVAL_SECONDS=300
COPILOT_FULL_RECONCILE_HOURS=24

# ── LLM gateways ──────────────────────────────────────────────────────────────
# OpenRouter (Copilot answers)
OPENROUTER_API_KEY=<openrouter-key>
OPENROUTER_DAILY_LIMIT=50
COPILOT_LLM_MODELS=<same-as-dev>
LLM_USER_DAILY_TOKENS=90000
# OpenAI-compatible gateway (HeyRoute) — same values as dev
LLM_API_BASE=<same-as-dev>
LLM_API_KEY=<heyroute-key>
LLM_MODEL=<same-as-dev>
LLM_PROVIDER=<same-as-dev>
CALLPREP_LLM_MODEL=<same-as-dev>
CHANNEL_LLM_MODEL=<same-as-dev>
# Google Gemini
GEMINI_API_KEY=<gemini-key>
# Others the Admin page can also hold (only if you use them)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Email (notifications, password reset) ─────────────────────────────────────
# Until these are set, emails are only written to the log. Notifications also need the
# Admin → CRM settings switch.
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=Doshin <noreply@<your-domain>>

# ── Microsoft 365 activity capture (optional) ─────────────────────────────────
# Entra ID app: add redirect URI https://<your-domain>/api/crm/capture/callback/microsoft
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# ── Research / scraping APIs — same values as dev ─────────────────────────────
APIFY_TOKEN=<apify-token>
APIFY_BACKUP_TOKENS=
CONTENT_APIFY_TOKEN=
LINKEDIN_ACTOR_ID=<same-as-dev>
TWITTER_ACTOR_ID=<same-as-dev>
REDDIT_ACTOR_ID=<same-as-dev>
BLOG_ACTOR_ID=<same-as-dev>
MONID_API_KEY=<monid-key>
MONID_BASE_URL=https://api.monid.ai/v1
TAVILY_API_KEY=<tavily-key>
EXA_API_KEY=<exa-key>
FIRECRAWL_API_KEY=<firecrawl-key>
SERPER_API_KEY=<serper-key>
FINNHUB_API_KEY=<finnhub-key>
DIFFBOT_TOKEN=<diffbot-token>
FULLENRICH_API_KEY=<fullenrich-key>
DATA_GOV_API_KEY=
YOUTUBE_API_KEY=

# ── Paths ─────────────────────────────────────────────────────────────────────
# /app/output inside the container = /opt/salesai/data/output on the host
OUTPUT_DIR=output
